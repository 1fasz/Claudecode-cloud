# ============================================================
# CSLegalTech / VulcanCloud Phone Answering App - Config
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Your public URL (use ngrok for local dev: ngrok http 3000)
# Example: https://abc123.ngrok.io
PUBLIC_URL=https://your-domain.com

# ------------------------------------------------------------
# Twilio Configuration
# Get these from: https://console.twilio.com
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ------------------------------------------------------------
# Anthropic Claude API
# Get from: https://console.anthropic.com
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# Microsoft Graph API (Office365 Calendar)
# Register an app at: https://portal.azure.com -> Azure Active Directory -> App registrations
# Required permissions: Calendars.ReadWrite, User.Read.All
# ------------------------------------------------------------
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kourtney's own Office365 account (used for auth context, not for booking)
CALENDAR_USER_EMAIL=kourtney@cslegaltech.com

# Staff calendars — Kourtney books appointments ON these people's calendars
STAFF_PAT_EMAIL=pat@cslegaltech.com
STAFF_MICHELLE_EMAIL=michelle@cslegaltech.com
STAFF_MICHAEL_EMAIL=michael@cslegaltech.com

# ------------------------------------------------------------
# Business Configuration
# ------------------------------------------------------------
# Comma-separated list of staff emails who can take calls
STAFF_PHONE_NUMBERS=+1XXXXXXXXXX,+1XXXXXXXXXX

# Timezone for appointments (IANA format)
TIMEZONE=America/New_York

# Business hours (24h format, used by the AI to guide scheduling)
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00
BUSINESS_DAYS=Monday,Tuesday,Wednesday,Thursday,Friday

# Default appointment duration in minutes
DEFAULT_APPOINTMENT_DURATION=30

# Voicemail fallback email (if call can't be handled)
VOICEMAIL_EMAIL=info@cslegaltech.com
